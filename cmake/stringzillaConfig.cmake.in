@PACKAGE_INIT@

# The libraries link the runtimes of the GPU units they carry.
include(CMakeFindDependencyMacro)
if (NOT "@STRINGZILLA_CUDA_ARCH@" STREQUAL "")
    find_dependency(CUDAToolkit)
endif ()
if (NOT "@STRINGZILLA_ROCM_ARCH@" STREQUAL "")
    find_dependency(hip)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/stringzillaTargets.cmake")

# The export defines `stringzilla::abi`, `stringzilla::cpp`, `stringzilla::header`, `stringzilla::static`, and
# `stringzilla::shared`. Flavors as components, so `check_required_components` accepts `COMPONENTS shared` and rejects
# only what is absent.
foreach (stringzilla_flavor_ abi cpp header static shared)
    if (TARGET stringzilla::${stringzilla_flavor_})
        set(stringzilla_${stringzilla_flavor_}_FOUND TRUE)
    endif ()
endforeach ()
unset(stringzilla_flavor_)

# No `stringzilla_VERSION` here: `find_package` sets it from the version file before loading this one, and
# `configure_package_config_file` never defines `PACKAGE_VERSION`, so assigning it here overwrote it with nothing.
check_required_components(stringzilla)
