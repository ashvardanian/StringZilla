        candidate = parts[k]; sub(/[[:space:]]*(\[[^]]*\])?[[:space:]]*$/, "", candidate)
        if (match(candidate, /[A-Za-z_][A-Za-z0-9_]*$/)) { name = substr(candidate, RSTART, RLENGTH); if (name !~ /^(void|const|int|float|double|char|bool|auto)$/) params[name] = 1 }
    }
