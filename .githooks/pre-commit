        inside && !in_code && (FNR in added) {
            prose = $0
            gsub(/`[^`]*`/, "", prose); gsub(/@(c|p|ref|sa|see|copydoc|link)[[:space:]]+[^[:space:]]+/, "", prose); gsub(/https?:[^[:space:]]+/, "", prose)
            if (prose ~ /(^|[^A-Za-z0-9_:@])[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_~][A-Za-z0-9_:]*/) printf "line %d: %s\n", FNR, $0
