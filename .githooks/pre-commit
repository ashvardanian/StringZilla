#!/usr/bin/env bash
#
# StringZilla pre-commit hook - house-style guards over staged C/C++/CUDA (and the public headers).
# Install once per clone with:  git config core.hooksPath .githooks
# Bypass in a genuine emergency with:  git commit --no-verify

set -u

# Rules below split into two kinds. A few deliberately police prose - the decorative-separator and
# `#pragma region` checks - and read added lines as they stand. The rest police code, and a comment that
# merely names the construct it bans is not a violation: "GCC lowered this to a memset call" explains a
# kernel, it does not call LibC. Those pipe through `code_only`, which blanks `//` tails, single-line
# `/* ... */` spans, and any line whose first non-blank character continues a block comment. The intent
# is to keep the guards honest about what they are reading, not to weaken them: nothing that survives on
# a code line is let through.
code_only() {
    # Input lines arrive from `grep -n`, so an optional `NNN:` prefix precedes the diff's `+`.
    sed -E \
        -e 's,//.*$,,' \
        -e 's,/\*([^*]|\*+[^*/])*\*+/,,g' \
        -e 's,^([0-9]*:?\+[[:space:]]*)(\*|/\*).*$,\1,'
}

# Decorative comment separators - runs of three or more `-` or `=` used purely as visual dividers inside
# C/C++ comments. Proper sentences communicate structure better than attention-grabbing rules.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM \
    -- '*.c' '*.h' '*.hpp' '*.cpp' '*.cc' '*.cxx' '*.cu' '*.cuh' '*.inl')
separators=0
for file in "${staged[@]}"; do
    [ -f "$file" ] || continue
    while IFS= read -r line; do
        added="${line#+}"
        if printf '%s\n' "$added" | grep -qE '(//|/\*|^\s*\*).*[-=]{3,}'; then
            if [ "$separators" -eq 0 ]; then
                printf 'Decorative comment separators are not allowed (--- / ===):\n\n' >&2
            fi
            printf '  %s: %s\n' "$file" "$(printf '%s' "$added" | sed 's/^[[:space:]]*//')" >&2
            separators=$((separators + 1))
        fi
    done < <(git diff --cached -U0 -- "$file" | grep -E '^\+' | grep -vE '^\+\+\+')
done
if [ "$separators" -ne 0 ]; then
    printf '\nWrite a plain sentence instead, or bypass with --no-verify.\n' >&2
    exit 1
fi

# The `&*iterator` antipattern (iterator -> reference -> pointer laundering). Use the container's
# `.data()`, `std::to_address(it)`, or a raw pointer directly instead.
laundering=$(git diff --cached --no-color -U0 -- '*.c' '*.h' '*.cc' '*.hpp' '*.cuh' '*.cu' \
  | grep -nE '^\+' | code_only | grep -E '&\*' || true)
if [ -n "$laundering" ]; then
  cat >&2 <<EOF
pre-commit: '&*' antipattern in staged changes (use .data() / std::to_address / a raw pointer):
$laundering
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# Pointer laundering through an integer, as in `(unsigned char *)(void *)(sz_size_t)pointer`. Routing a
# pointer through an integer type to shed `const` or to satisfy an intrinsic's signature hides exactly the
# mismatch a reader needs to see, and it defeats provenance tracking in the optimizer and in sanitizers.
# Cast to the pointer type you mean, once. If an intrinsic genuinely wants a non-const pointer, a single
# `(T *)` is honest; the chain through `sz_size_t` / `uintptr_t` / `size_t` is not.
pointer_laundering=$(git diff --cached --no-color -U0 -- '*.c' '*.h' '*.cc' '*.hpp' '*.cuh' '*.cu' \
  | grep -nE '^\+' | code_only \
  | grep -E '\([[:space:]]*(sz_size_t|sz_u64_t|uintptr_t|size_t|unsigned long|long)[[:space:]]*\)[[:space:]]*[A-Za-z_]' \
  | grep -E '\)[[:space:]]*\([[:space:]]*(void|[A-Za-z_][A-Za-z_0-9]*)[[:space:]]*\*' || true)
if [ -n "$pointer_laundering" ]; then
  cat >&2 <<EOF
pre-commit: pointer cast through an integer type (cast to the pointer type you mean, once):
$pointer_laundering
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# Discarding a value via `(void)expr;` instead of a named mechanism. This codebase already has one:
# `sz_unused_(x)` (types.h), used 50+ times for an unused parameter or local kept for a shared signature.
# For a declaration site (a parameter or a single local you never read), `SZ_MAYBE_UNUSED` is the
# alternative. A bare `(void)x;` statement is neither greppable as an intentional marker nor consistent
# with either existing convention.
void_discard=$(git diff --cached --no-color -U0 -- '*.c' '*.h' '*.cc' '*.hpp' '*.cuh' '*.cu' \
  | grep -nE '^\+' | code_only \
  | grep -E '\(void\)[A-Za-z_][A-Za-z_0-9]*[[:space:]]*[,;]' || true)
if [ -n "$void_discard" ]; then
  cat >&2 <<EOF
pre-commit: '(void)expr;' discard (use sz_unused_(x) for a statement, or SZ_MAYBE_UNUSED on the declaration):
$void_discard
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# Dashes in `#pragma region` / `#pragma endregion` names: clang-format parses the trailing text as an
# expression and rewrites `X-Y` into `X - Y`, desyncing region/endregion pairs. Use spaces in region names instead.
pragma_dashes=$(git diff --cached --no-color -U0 -- '*.c' '*.h' '*.cc' '*.hpp' '*.cuh' '*.cu' \
  | grep -nE '^\+' | grep -E '#pragma[[:space:]]+(region|endregion)' | grep -E '[A-Za-z0-9] *- *[A-Za-z0-9]' || true)
if [ -n "$pragma_dashes" ]; then
  cat >&2 <<EOF
pre-commit: dash in a #pragma region/endregion name (clang-format rewrites 'X-Y' to 'X - Y'); use spaces:
$pragma_dashes
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# LibC string/memory symbols under include/stringzilla/**: StringZilla supersedes LibC and cannot share a
# translation unit with the compiler `__builtin_*` it emits. Use the project wrappers (`sz_copy`, `sz_fill`,
# `sz_move`, `sz_equal`) or a `sz_u(128|256|512)_vec_t` union `.u8s[]` buffer for staging. The default allocator
# and assert live in `types.h` (the sanctioned LibC touch-points) and are excluded; the `alloc->`/`allocator->`
# callbacks are not LibC.
libc=$(git diff --cached --no-color -U0 -- 'include/stringzilla' ':(exclude)include/stringzilla/types.h' \
  | grep -nE '^\+' | code_only \
  | grep -wE 'memset|memcpy|memmove|memcmp|strlen|strcpy|strncpy|strcat|strcmp|strncmp|strchr|strrchr|strstr|strcasecmp|strncasecmp' \
  | grep -vE '__builtin_|sz_(copy|fill|move|equal|order|hash)|alloc(ator)?->' || true)
if [ -n "$libc" ]; then
  cat >&2 <<EOF
pre-commit: LibC string/memory symbol in staged include/stringzilla changes (StringZilla supersedes LibC).
Use sz_copy / sz_fill / sz_move / sz_equal, or a sz_u(128|256|512)_vec_t union .u8s[] staging buffer:
$libc
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# GitHub Actions job & step names: no parentheses, and the visible name starts with an uppercase letter
# (or a `${{ … }}` expression). Checks job-level `name:` keys (8-space indent in our 4-space YAML style)
# and step-level `- name:` items on ADDED lines only, so `with:` parameters like artifact names are
# untouched. Prefer `Test Rust with compile-time dispatch` over `Test Rust (compile-time dispatch)`, and
# `QEMU Tests ${{ matrix.target_arch }}` over `QEMU Tests (${{ matrix.target_arch }})`.
workflow_names=$(git diff --cached --no-color -U0 -- '.github/workflows/*.yml' '.github/workflows/*.yaml' \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -E '^\+( {8}name:| *- name:)' \
  | grep -E '[()]|name:[[:space:]]*["'"'"']?[a-z]' || true)
if [ -n "$workflow_names" ]; then
  cat >&2 <<EOF
pre-commit: workflow job/step names must avoid parentheses and start with an uppercase letter:
$workflow_names
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# Shared test scaffolding lives only in test/sz_helpers.py, test/szs_helpers.py, test/utf8_helpers.py,
# and test/conftest.py. Every other test file imports it, so corpora, the seed system, the iterations
# multiplier, and the backend sweep can't drift apart.
scaffolding=$(git diff --cached --no-color -U0 \
  -- 'test/*.py' ':(exclude)test/sz_helpers.py' ':(exclude)test/szs_helpers.py' ':(exclude)test/utf8_helpers.py' ':(exclude)test/conftest.py' \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -E '^\+(def (vector_width_bracketing_strings|malformed_utf8_corpus|boundary_strings|differential_bodies|get_random_string|is_equal_strings|seed_random_generators|scale_iterations|unaligned_views|run_across_backends|assert_backends_agree|run_across_engines|assert_engines_agree|device_scope_and_capabilities|generate_string_batches|capability_sweep|forced_capabilities)\(|(SEED_VALUES|ITERATIONS_MULTIPLIER)[[:space:]]*=)' || true)
if [ -n "$scaffolding" ]; then
  cat >&2 <<EOF
pre-commit: shared test scaffolding redefined outside test/sz_helpers.py; import it instead:
$scaffolding
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# Seeded tests parametrize over test.sz_helpers.SEED_VALUES, not a hardcoded literal list, so every run
# includes the per-run random seed and honors SZ_TESTS_SEED.
seedlists=$(git diff --cached --no-color -U0 -- 'test/*.py' \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -E 'parametrize\(.*"seed_value".*,[[:space:]]*\[' || true)
if [ -n "$seedlists" ]; then
  cat >&2 <<EOF
pre-commit: parametrize seed_value over test.sz_helpers.SEED_VALUES, not a literal list:
$seedlists
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# Random-draw fuzz loops use a throwaway target and must scale with SZ_TESTS_MULTIPLIER, so their count
# is wrapped in scale_iterations(...). Algorithmic loops use a named index and are left alone.
frozen_fuzz=$(git diff --cached --no-color -U0 -- 'test/*.py' \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -E 'for _ in range\([0-9]' || true)
if [ -n "$frozen_fuzz" ]; then
  cat >&2 <<EOF
pre-commit: frozen fuzz-loop count; wrap it as 'for _ in range(scale_iterations(N)):'
$frozen_fuzz
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# sz_u32_ctz/sz_u64_ctz/sz_u32_clz/sz_u64_clz/sz_u32_popcount/sz_u64_popcount (types.h) exist for
# serial.h and for every ISA that has no reason to bypass them: WASM/PowerVSX/LoongArch/RVV builtins carry
# no target-feature-gating risk on those platforms, so the wrapper is the right, searchable, internal-name
# call there - only x86 (real feature-gated named intrinsics) and SVE2 (predicate-domain ACLE forms, no
# MSVC target) and NEON (MSVC/ARM64 has no __builtin_*/ACLE) have a genuine reason to bypass it.

# x86 named intrinsics required - westmere/goldmont/haswell/skylake/icelake: the wrapper AND the ISA-agnostic
# __builtin_ctz/clz/popcount are both banned. x86 has real named, feature-gated intrinsics
# (_tzcnt_u32/64, _lzcnt_u32/64, _mm_popcnt_u32/64) - use them directly so a missing bmi/lzcnt/popcnt
# pragma flag is a compile error, not __builtin_ctz's silent bsf downgrade (find/haswell.h shipped that
# exact bug once).
x86_wrapper=$(git diff --cached --no-color -U0 \
  -- 'include/stringzilla/*/westmere.h' 'include/stringzilla/*/goldmont.h' 'include/stringzilla/*/haswell.h' \
     'include/stringzilla/*/skylake.h' 'include/stringzilla/*/icelake.h' \
  | grep -nE '^\+' | grep -vE '^\+\+\+' | code_only \
  | grep -E 'sz_u(32|64)_(ctz|clz|popcount)\(|__builtin_(ctz|clz|popcount)' || true)

# ACLE required on SVE2 - sve/sve2.h have no MSVC target, so __clz/__clz(__rbit(x))/__builtin_popcount (or
# predicate-domain svcntp_b8/svbrkb_b_z) are the direct form there; only the wrapper is banned.
other_wrapper=$(git diff --cached --no-color -U0 \
  -- 'include/stringzilla/*/sve.h' 'include/stringzilla/*/sve2.h' \
  | grep -nE '^\+' | grep -vE '^\+\+\+' | code_only \
  | grep -E 'sz_u(32|64)_(ctz|clz|popcount)\(' || true)

# NEON needs the MSVC-safe macros - neon.h bans both the generic wrapper AND bare __builtin_ctz/clz/popcount. Real MSVC/ARM64
# compiles these files and has no __builtin_*/ACLE support, so every NEON file must go through the
# sz_u32_ctz_neon_/sz_u32_clz_neon_/sz_u32_popcount_neon_ (and 64-bit) macros defined once in types.h,
# which branch _MSC_VER vs ACLE internally - calling __builtin_ctz bare compiles fine on GCC/Clang but
# breaks the real MSVC/ARM64 build silently.
neon_wrapper=$(git diff --cached --no-color -U0 \
  -- 'include/stringzilla/*/neon.h' \
  | grep -nE '^\+' | grep -vE '^\+\+\+' | code_only \
  | grep -E 'sz_u(32|64)_(ctz|clz|popcount)\(|__builtin_(ctz|clz|popcount)' || true)

if [ -n "$x86_wrapper" ] || [ -n "$other_wrapper" ] || [ -n "$neon_wrapper" ]; then
  cat >&2 <<EOF
pre-commit: sz_u32_ctz/clz/popcount (or a bare __builtin_ctz/clz/popcount on x86) in a staged ISA kernel
file. Call the platform's direct intrinsic instead - x86: _tzcnt_u32/_lzcnt_u32/_mm_popcnt_u32 (64-bit
forms too); SVE2: __clz / __clz(__rbit(x)) / __builtin_popcount; NEON: sz_u32_ctz_neon_/sz_u32_clz_neon_/
sz_u32_popcount_neon_ from types.h (MSVC/ARM64 has no __builtin_*). WASM/PowerVSX/LoongArch/RVV use the
wrapper directly - no fragility risk there, so this shouldn't be firing on those files at all.
${x86_wrapper}${other_wrapper}${neon_wrapper}
EOF
  exit 1
fi

# Raw libc assert() in test/ is silently stripped by the -DNDEBUG that CMake's Release and
# RelWithDebInfo configs add by default - exactly the configs CI builds the test binaries with.
# The test suite's oracle must never be a no-op: use verify() / let_verify() / scope_verify() /
# throws_verify() from test/stringzilla.hpp instead, which are never gated by NDEBUG or SZ_DEBUG.
raw_assert=$(git diff --cached --no-color -U0 -- 'test/*.c' 'test/*.h' 'test/*.cpp' 'test/*.hpp' 'test/*.cuh' 'test/*.cu' \
  | grep -E '^\+' | grep -vE '^\+\+\+' | code_only \
  | grep -E '(^|[^A-Za-z0-9_])assert[[:space:]]*\(' || true)
if [ -n "$raw_assert" ]; then
  cat >&2 <<EOF
pre-commit: raw assert() in staged test/ changes (stripped by -DNDEBUG in CI's Release/RelWithDebInfo
test builds). Use verify() / let_verify() / scope_verify() / throws_verify() instead:
$raw_assert
Bypass with --no-verify only if intentional.
EOF
  exit 1
fi

# SIMD register naming across every ISA backend (cipher/hash/find/compare/intersect/memory/sort/utf8_*)
# plus types.h, where the union wrapper types themselves live: every raw fixed-width register (x86
# __m128i/__m256i/__m512i, NEON uint8x16_t etc, WASM v128_t, Power __vector unsigned char/int/long long,
# LoongArch LASX/LSX __m256i/__m128i) carries a `_<dtype>x<lanes>` suffix (`_u8x16`/`_u32x8`/`_u64x2`/...);
# SVE scalable registers (svuint8_t etc) carry `_<dtype>x`; RVV registers (vuint8m1_t..m8, any element
# width) carry `_<dtype>m<lmul>`; x86 k-masks (__mmask8/16/32/64) carry `_m<n>`; SVE/RVV predicates
# (svbool_t/vbool<n>_t) carry `_b<n>x`/`_b<n>`. The other direction: locals or parameters typed (or
# pointer-to) sz_u16_vec_t / sz_u32_vec_t / sz_u64_vec_t / sz_u128_vec_t / sz_u256_vec_t / sz_u512_vec_t
# (the union wrapper types) always end in a bare `_vec` suffix instead (or are simply named `vec` outright
# in small single-variable helpers) - never a dtype x lanes suffix, since they are not raw registers. Struct fields of either kind are exempt (this check can not tell a
# struct field from a local from token scanning alone - name a struct member as freely as the type it
# packs demands and grandfather the line with `// sz-nolint: naming` if this fires on one anyway). Scoped
# to include/stringzilla/*/*.h and include/stringzilla/types.h (every family's serial.h/tables.h excluded
# - portable/table-only, but types.h itself is IN scope since the union types are declared there),
# added lines only, so legacy violations migrate on their own schedule.
cipher_naming_awk='
BEGIN {
    na = split(added, ar, "\n")
    for (j = 1; j <= na; j++) if (ar[j] != "") ADDED[ar[j]] = 1
}
{
    if (match($0, /^[0-9]+:/)) { lineno = substr($0, 1, RLENGTH - 1); content = substr($0, RLENGTH + 1) }
    else next
    if (!(lineno in ADDED)) next

    line = content
    gsub(/\/\/.*/, "", line)
    gsub(/__vector unsigned char/, "__vector_uchar", line)
    gsub(/__vector unsigned int/, "__vector_uint", line)
    gsub(/__vector unsigned long long/, "__vector_ulonglong", line)
    n = split(line, tok, /[[:space:]]+/)
    for (i = 1; i <= n; i++) {
        t = tok[i]
        is_raw = (t ~ /^(__m128i|__m256i|__m512i|__mmask(8|16|32|64)|uint8x16_t|v128_t|sv(uint|int|float)(8|16|32|64)_t|svbool_t|v(uint|int|float)(8|16|32|64)m[1248]_t|vbool[0-9]+_t|__vector_uchar|__vector_uint|__vector_ulonglong)$/)
        is_wrapper = (t ~ /^sz_u(16|32|64|128|256|512)_vec_t$/)
        if (!is_raw && !is_wrapper) continue
        name = tok[i + 1]
        if (name ~ /^const,?$/) name = tok[i + 2]
        if (name == "") continue
        if (name ~ /\(/) continue
        gsub(/^\*+/, "", name)
        sub(/[=;,)*[].*/, "", name)
        if (name == "" || name ~ /[^A-Za-z0-9_]/) continue
        if (is_raw) {
            suffix_ok = (name ~ /_[a-z]{1,2}[0-9]{1,2}(x[0-9]*|m[0-9])s?$/) || (name ~ /_m[0-9]+$/) || (name ~ /_b[0-9]+x?$/)
        } else {
            suffix_ok = (name ~ /_vec$/) || (name == "vec")
        }
        if (!suffix_ok) print fname":"lineno": "t" -> "name
    }
}
'
while IFS= read -r file; do
    case "$file" in
    */serial.h | */tables.h) continue ;;
    include/stringzilla/*/*.h | include/stringzilla/types.h) ;;
    *) continue ;;
    esac
    added_nums=$(git diff --cached --unified=0 -- "$file" \
        | awk '/^@@/ { for (i = 1; i <= NF; i++) if ($i ~ /^\+[0-9]/) { split(substr($i, 2), p, ","); s = p[1]; c = (p[2] == "" ? 1 : p[2]); for (k = 0; k < c; k++) print s + k; break } }')
    [ -n "$added_nums" ] || continue
    cipher_naming=$(git show ":$file" 2> /dev/null \
        | grep -nv 'sz-nolint: naming' \
        | awk -v added="$added_nums" -v fname="$file" "$cipher_naming_awk" || true)
    if [ -n "$cipher_naming" ]; then
        echo "pre-commit: $file has a SIMD register missing its dtype x lanes / mask suffix:" >&2
        printf '%s\n' "$cipher_naming" | head -10 >&2
        echo "Bypass with --no-verify only if intentional, or grandfather with '// sz-nolint: naming'." >&2
        exit 1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -- 'include/stringzilla/*/*.h')

exit 0
