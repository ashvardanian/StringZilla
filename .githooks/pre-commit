# region StringZilla Rules

# The added lines of a C-family file with comments blanked, so a code check never fires on prose naming it.
added_code_text() { printf '%s\n' "$staged_added_text" | sed -E '/\*\//!s,^\+[[:space:]]*\*([[:space:]].*)?$,+,' | blank_c_comments_preserving_columns; }

# Rejects `&*iterator`, because laundering an iterator through a reference into a pointer hides what it
# points into; take `.data()`, `std::to_address(iterator)`, or a raw pointer.
check_iterator_address_not_laundered() {
    local laundered
    laundered=$(added_code_text | grep -E '&\*' || true)
    [ -z "$laundered" ] || reject_with_reason "$laundered" \
        "$staged_path takes &* of an iterator; use .data(), std::to_address or a raw pointer:"
}

# Rejects a pointer cast through an integer, as in `(char *)(void *)(sz_size_t)pointer`, because the detour
# hides the mismatch a reader needs to see and defeats provenance tracking in optimizers and sanitizers.
check_pointer_not_cast_through_integer() {
    local detours
    detours=$(added_code_text |
        grep -E '\([[:space:]]*(sz_size_t|sz_u64_t|uintptr_t|size_t|unsigned long|long)[[:space:]]*\)[[:space:]]*[A-Za-z_]' |
        grep -E '\)[[:space:]]*\([[:space:]]*(void|[A-Za-z_][A-Za-z_0-9]*)[[:space:]]*\*' || true)
    [ -z "$detours" ] || reject_with_reason "$detours" \
        "$staged_path casts a pointer through an integer; cast to the pointer type you mean, once:"
}

# Rejects indexing straight through a call or a cast, as in `owner.view()[index]`, because the owning
# container has its own `operator[]` and anything else deserves a named local. A reference-to-array
# parameter, `T const (&name)[count]`, is a declaration and passes.
check_call_result_not_indexed() {
    local chains
    chains=$(added_code_text | grep -E '\)\[' | grep -vE '\(&[A-Za-z_][A-Za-z0-9_]*\)\[' || true)
    [ -z "$chains" ] || reject_with_reason "$chains" \
        "$staged_path indexes through a call or a cast; index the owning container, or bind a named local:"
}

# Rejects a LibC string or memory call in include/stringzilla, because StringZilla supersedes LibC and cannot
# share a translation unit with the builtins it lowers to; types.h keeps the sanctioned allocator and assert.
check_libc_absent_from_library() {
    [ "$staged_path" != include/stringzilla/types.h ] || return 0
    local calls
    calls=$(added_code_text |
        grep -wE 'memset|memcpy|memmove|memcmp|strlen|strcpy|strncpy|strcat|strcmp|strncmp|strchr|strrchr|strstr|strcasecmp|strncasecmp' |
        grep -vE '__builtin_|sz_(copy|fill|move|equal|order|hash)|alloc(ator)?->' || true)
    [ -z "$calls" ] || reject_with_reason "$calls" \
        "$staged_path calls LibC; use sz_copy, sz_fill, sz_move or sz_equal, or stage through a" \
        "            sz_u(128|256|512)_vec_t union's .u8s[] buffer:"
}

# Rejects iostreams, because the streambuf machinery drags virtual dispatch into every binary; LibC's
# <cstdio> does the same work.
check_iostreams_absent() {
    local streams
    streams=$(added_code_text |
        grep -E '#include[[:space:]]*<(iostream|fstream|sstream)>|std::(cout|cerr|cin|ifstream|ofstream|fstream|stringstream|ostringstream|istringstream|endl)([^A-Za-z0-9_]|$)' || true)
    [ -z "$streams" ] || reject_with_reason "$streams" \
        "$staged_path uses iostreams; use std::fopen, std::fread, std::fwrite or std::snprintf from <cstdio>:"
}

# Rejects the portable bit-scan wrappers where an ISA has a direct form. On x86 a named intrinsic turns a
# missing `bmi`, `lzcnt` or `popcnt` target flag into a compile error instead of a silent `bsf`; SVE2 has
# no MSVC target, so ACLE is direct; NEON must build on MSVC, so it goes through the `_neon_` macros.
check_bit_scans_per_isa() {
    local banned scans
    case "${staged_path##*/}" in
    westmere.h | goldmont.h | haswell.h | skylake.h | icelake.h) banned='sz_u(32|64)_(ctz|clz|popcount)\(|__builtin_(ctz|clz|popcount)' ;;
    sve.h | sve2.h) banned='sz_u(32|64)_(ctz|clz|popcount)\(' ;;
    neon.h) banned='sz_u(32|64)_(ctz|clz|popcount)\(|__builtin_(ctz|clz|popcount)' ;;
    *) return 0 ;;
    esac
    scans=$(added_code_text | grep -E "$banned" || true)
    [ -z "$scans" ] || reject_with_reason "$scans" \
        "$staged_path bit-scans through a portable wrapper; x86 calls _tzcnt_u32, _lzcnt_u32 or" \
        "            _mm_popcnt_u32, SVE2 calls __clz or __builtin_popcount, NEON calls sz_u32_ctz_neon_ and kin:"
}

# Rejects a SIMD register variable whose name omits its element type and width, because the name is the
# only type annotation a kernel reader sees. Raw fixed-width registers end in `_<dtype>x<lanes>`, SVE in
# `_<dtype>x`, RVV in `_<dtype>m<lmul>`, x86 masks in `_m<bits>`, predicates in `_b<bits>`; the
# `sz_u*_vec_t` unions end in `_vec`. Lines tagged `// sz-nolint: naming` are exempt.
check_register_names_carry_dtype_and_width() {
    local misnamed exempt_line_numbers
    exempt_line_numbers=$(printf '%s\n' "$staged_file_text" | grep -n 'sz-nolint: naming' | cut -d: -f1)
    misnamed=$(printf '%s\n' "$staged_file_text" | blank_c_comments_preserving_columns |
        added_list="$staged_added_line_numbers_list" exempt_list="$exempt_line_numbers" awk '
        BEGIN {
            count = split(ENVIRON["added_list"], numbers, "\n"); for (index_ = 1; index_ <= count; ++index_) added[numbers[index_] + 0] = 1
            count = split(ENVIRON["exempt_list"], numbers, "\n"); for (index_ = 1; index_ <= count; ++index_) exempt[numbers[index_] + 0] = 1
        }
        (FNR in added) && !(FNR in exempt) {
            line = $0
            gsub(/__vector unsigned char/, "__vector_uchar", line)
            gsub(/__vector unsigned int/, "__vector_uint", line)
            gsub(/__vector unsigned long long/, "__vector_ulonglong", line)
            token_count = split(line, tokens, /[[:space:]]+/)
            for (token_index = 1; token_index <= token_count; ++token_index) {
                token = tokens[token_index]
                is_raw = (token ~ /^(__m128i|__m256i|__m512i|__mmask(8|16|32|64)|uint8x16_t|v128_t|sv(uint|int|float)(8|16|32|64)_t|svbool_t|v(uint|int|float)(8|16|32|64)m[1248]_t|vbool[0-9]+_t|__vector_uchar|__vector_uint|__vector_ulonglong)$/)
                is_union = (token ~ /^sz_u(16|32|64|128|256|512)_vec_t$/)
                if (!is_raw && !is_union) continue
                name = tokens[token_index + 1]
                if (name ~ /^const,?$/) name = tokens[token_index + 2]
                if (name == "" || name ~ /\(/) continue
                gsub(/^\*+/, "", name)
                sub(/[=;,)*[].*/, "", name)
                if (name == "" || name ~ /[^A-Za-z0-9_]/) continue
                if (is_raw) valid = (name ~ /_[a-z]{1,2}[0-9]{1,2}(x[0-9]*|m[0-9])s?$/) || (name ~ /_m[0-9]+$/) || (name ~ /_b[0-9]+x?$/)
                else valid = (name ~ /_vec$/) || (name == "vec")
                if (!valid) printf "line %d: %s %s\n", FNR, token, name
            }
        }' || true)
    [ -z "$misnamed" ] || reject_with_reason "$misnamed" \
        "$staged_path names a SIMD register without its dtype and width, <role>_u8x16, _u8x, _u8m1," \
        "            _m64 or _b8, or a sz_u*_vec_t union without _vec; grandfather a line with // sz-nolint: naming:"
}

# Rejects `@copydoc` in a per-ISA backend, because the family header documents each backend at its
# declaration; a note here says what this backend does differently, or nothing.
check_copydoc_absent_in_backends() {
    local copies
    copies=$(printf '%s\n' "$staged_added_text" | grep -E '@copydoc' || true)
    [ -z "$copies" ] || reject_with_reason "$copies" \
        "$staged_path repeats @copydoc in a backend; the family header already documents the declaration:"
}

# Rejects C++ constructs and `<<< >>>` launches in include/stringzilla `.cuh` headers, because those tiers
# are C so the C dispatch units can link them; `extern "C"` is the one C++ spelling allowed.
check_cuda_headers_stay_c() {
    local cpp_constructs
    cpp_constructs=$(printf '%s\n' "$staged_file_text" | blank_c_comments_preserving_columns | grep -nE \
        '(^|[^A-Za-z0-9_])(template[[:space:]]*<|class[[:space:]]+[A-Za-z_]|namespace[[:space:]]|auto[[:space:]]+[A-Za-z_*&]|nullptr|new[[:space:]]+[A-Za-z_]|delete[[:space:]]|std::|constexpr[[:space:]]|noexcept|public:|private:|protected:|operator[[:space:]]*[^(])|<<<' |
        grep -vE 'extern[[:space:]]+"C"' |
        added_list="$staged_added_line_numbers_list" awk -F: '
            BEGIN { count = split(ENVIRON["added_list"], numbers, "\n"); for (index_ = 1; index_ <= count; ++index_) added[numbers[index_] + 0] = 1 }
            ($1 + 0) in added' || true)
    [ -z "$cpp_constructs" ] || reject_with_reason "$cpp_constructs" \
        "$staged_path adds C++, but include/stringzilla .cuh tiers are C with \`extern \"C\"\` linkage;" \
        "            write C, and launch with cudaLaunchKernel and an explicit dim3 instead of <<< >>>:"
}

# Rejects an export macro on a binding definition, because the binding declares its helpers plain `extern`
# and MSVC rejects the mismatched pair as C2375.
check_binding_exports_absent() {
    local exported
    exported=$(added_code_text | grep -E '^\+[[:space:]]*STRINGZILLA_API_RUNTIME[[:space:]]' || true)
    [ -z "$exported" ] || reject_with_reason "$exported" \
        "$staged_path exports a binding-internal definition; drop the macro, the module exports only its init:"
}

# Rejects `assert` and `sz_assert_` in test/, because the Release configs CI tests with compile both out;
# `verify`, `let_verify`, `scope_verify` and `throws_verify` from test/harness.hpp never are.
check_test_oracle_never_compiled_out() {
    local asserts
    asserts=$(added_code_text | grep -E '(^|[^A-Za-z0-9_])(assert|sz_assert_)[[:space:]]*\(' || true)
    [ -z "$asserts" ] || reject_with_reason "$asserts" \
        "$staged_path asserts in a test, which Release builds compile out; use verify or its kin:"
}

# Rejects `verify(saw_...)` over a randomized sweep, because a low STRINGZILLA_SCALE turns the coverage
# claim into a coin flip; walk the pool deterministically, or pin an exact claim with `// sz-nolint: coverage`.
check_coverage_verify_pinned() {
    local coverage
    coverage=$(printf '%s\n' "$staged_added_text" | grep -E 'verify\([[:space:]]*(saw|seen|observed)_' |
        grep -v 'sz-nolint: coverage' || true)
    [ -z "$coverage" ] || reject_with_reason "$coverage" \
        "$staged_path asserts coverage over a randomized sweep; walk the pool, or pin it with // sz-nolint: coverage:"
}

# Rejects a print to stdout in a test body: the harness owns stdout, and a test only reports failures to
# stderr, so a passing run reads the same in every sibling.
check_test_bodies_quiet() {
    local prints
    prints=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -nE '\b(print_line|fmt::println|fmt::print|printf|puts)[[:space:]]*\(|\bstd::cout\b|\bfprintf[[:space:]]*\([[:space:]]*stdout\b' |
        grep -vE '\([[:space:]]*stderr\b' || true)
    [ -z "$prints" ] || reject_with_reason "$prints" \
        "$staged_path prints to stdout from a test body; report failures to stderr and leave progress" \
        "            to the harness:"
}

# Rejects raw CUDA memory calls in test/ and bench/, because `unified_vector`, `device_vector`,
# `pinned_vector` and `unified_memory_allocator()` already own every kind of memory these binaries need.
check_cuda_memory_through_scaffolding() {
    local raw
    raw=$(added_code_text |
        grep -E '(^|[^A-Za-z0-9_])cuda(Malloc|MallocHost|MallocManaged|HostAlloc|Free|FreeHost|Memcpy|MemcpyAsync)[[:space:]]*\(' |
        grep -vE 'cudaFree[[:space:]]*\([[:space:]]*(0|NULL|nullptr)[[:space:]]*\)' || true)
    [ -z "$raw" ] || reject_with_reason "$raw" \
        "$staged_path manages CUDA memory by hand; use unified_vector, device_vector, pinned_vector or" \
        "            unified_memory_allocator() from test/harness.hpp:"
}

# Rejects a releasing destructor in test/ and bench/, because such a struct stays copyable, and the
# callables reach `bench_unary` by value, so the second copy frees twice.
check_test_destructors_own_nothing() {
    local releasing
    releasing=$(added_code_text |
        grep -E '~[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[^;]*\{.*(cudaFree|cuMemFree|[[:space:]]delete|::free|[[:space:]]free)[[:space:]]*[\(\[]' || true)
    [ -z "$releasing" ] || reject_with_reason "$releasing" \
        "$staged_path releases memory in a destructor; hold the storage in a container with its own copy control:"
}

# Rejects a redefinition of the shared C++ scaffolding outside test/harness.hpp, because every test and
# bench opens its namespace, so a file-scope alias turns ambiguous.
check_cpp_scaffolding_in_one_header() {
    local redefined
    redefined=$(added_code_text |
        grep -E 'using[[:space:]]+(unified|pinned|device)_vector[[:space:]]*=|using[[:space:]]+arrow_strings_tape_t[[:space:]]*=|(unified|pinned|device)_alloc<[^>]*>[[:space:]]*\{[[:space:]]*\}[[:space:]]*\.[[:space:]]*(allocate|deallocate)' || true)
    [ -z "$redefined" ] || reject_with_reason "$redefined" \
        "$staged_path redefines scaffolding test/harness.hpp owns; extend that header instead:"
}

# Rejects a redefinition of the shared Python test scaffolding, because corpora, seeds, the iteration
# multiplier and the backend sweep live once, in test/helpers.py, test/utf8_helpers.py and test/conftest.py.
check_python_scaffolding_in_helpers() {
    local redefined
    redefined=$(printf '%s\n' "$staged_added_text" |
        grep -E '^\+(def (vector_width_bracketing_strings|malformed_utf8_corpus|boundary_strings|differential_bodies|get_random_string|is_equal_strings|seed_random_generators|scale_iterations|unaligned_views|run_across_backends|assert_backends_agree|run_across_engines|assert_engines_agree|device_scope_and_capabilities|generate_string_batches|capability_sweep|forced_capabilities)\(|(SEED_VALUES|ITERATIONS_MULTIPLIER)[[:space:]]*=)' || true)
    [ -z "$redefined" ] || reject_with_reason "$redefined" \
        "$staged_path redefines shared test scaffolding; import it from test/helpers.py:"
}

# Rejects a seeded test over a literal list, because SEED_VALUES carries the per-run seed and STRINGZILLA_SEED.
check_seed_values_parametrized() {
    local literal
    literal=$(printf '%s\n' "$staged_added_text" | grep -E 'parametrize\(.*"seed_value".*,[[:space:]]*\[' || true)
    [ -z "$literal" ] || reject_with_reason "$literal" \
        "$staged_path parametrizes seed_value over a literal list; use test.helpers.SEED_VALUES:"
}

# Rejects a fuzz loop with a fixed count, because every random draw scales with STRINGZILLA_SCALE.
check_fuzz_loops_scaled() {
    local frozen
    frozen=$(printf '%s\n' "$staged_added_text" | grep -E 'for _ in range\([0-9]' || true)
    [ -z "$frozen" ] || reject_with_reason "$frozen" \
        "$staged_path freezes a fuzz-loop count; write for _ in range(scale_iterations(N)):"
}

# Rejects the retired `SZ_` prefix on an all-caps name, because every macro, CMake variable and environment
# variable spells out the full `STRINGZILLA_`; lowercase `sz_` symbols keep theirs.
check_retired_prefix_absent() {
    local retired
    retired=$(printf '%s\n' "$staged_added_text" | grep -E '(^|[^A-Za-z0-9_]|-D)SZ_[A-Z0-9]' || true)
    [ -z "$retired" ] || reject_with_reason "$retired" \
        "$staged_path spells the retired SZ_ prefix; write the full STRINGZILLA_:"
}

# Rejects a positive `defined(...)` or `#ifdef` of an architecture, OS or toolchain fact, because each is
# always defined as 0 or 1 and `defined` is true on every platform; `!defined` and `#ifndef` guards pass.
check_facts_tested_by_value() {
    local tested
    tested=$(added_code_text |
        grep -E '(^|[^!A-Za-z0-9_])defined[[:space:]]*\(?[[:space:]]*STRINGZILLA_(ARCH|OS|HAS)_|#[[:space:]]*ifdef[[:space:]]+STRINGZILLA_(ARCH|OS|HAS)_' || true)
    [ -z "$tested" ] || reject_with_reason "$tested" \
        "$staged_path tests an always-defined STRINGZILLA_ARCH_, _OS_ or _HAS_ fact with defined; use #if:"
}

# Routes one staged file through the checks only StringZilla has.
run_project_checks() {
    case "$staged_path" in
    CHANGELOG*) ;;
    *) check_retired_prefix_absent ;;
    esac
    case "$staged_path" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cu | *.cuh)
        check_iterator_address_not_laundered
        check_pointer_not_cast_through_integer
        check_call_result_not_indexed
        check_iostreams_absent
        check_facts_tested_by_value
        ;;
    esac
    case "$staged_path" in
    include/stringzilla/*.h | include/stringzilla/*.cuh | include/stringzilla/*/*.h | include/stringzilla/*/*.cuh)
        check_libc_absent_from_library
        ;;
    esac
    case "$staged_path" in
    include/stringzilla/*/serial.h | include/stringzilla/*/tables.h) ;;
    include/stringzilla/*/*.h | include/stringzilla/types.h)
        check_register_names_carry_dtype_and_width
        check_bit_scans_per_isa
        ;;
    esac
    case "${staged_path##*/}" in
    serial.* | westmere.* | goldmont.* | haswell.* | skylake.* | icelake.* | neon.* | neonaes.* | neonsha.* | \
        sve.* | sve2.* | sve2aes.* | cuda.* | kepler.* | hopper.* | blackwell.* | rocm.* | cdna.* | \
        lasx.* | powervsx.* | rvv.* | rvvcrypto.* | v128.* | v128relaxed.*)
        case "$staged_path" in include/stringzilla/*/*) check_copydoc_absent_in_backends ;; esac
        ;;
    esac
    case "$staged_path" in
    include/stringzilla/*.cuh | include/stringzilla/*/*.cuh) check_cuda_headers_stay_c ;;
    python/*.c | python/*/*.c | javascript/*.c) check_binding_exports_absent ;;
    esac
    case "$staged_path" in
    test/*.c | test/*.h | test/*.cpp | test/*.hpp | test/*.cu | test/*.cuh)
        check_test_oracle_never_compiled_out
        check_coverage_verify_pinned
        ;;
    esac
    case "$staged_path" in
    test/harness.hpp | test/main.cpp | test/main.cu) ;;
    test/*.cpp | test/*.hpp | test/*.cu) check_test_bodies_quiet ;;
    esac
    case "$staged_path" in
    test/*.cu | test/*.cuh | bench/*.cu | bench/*.cuh) check_cuda_memory_through_scaffolding ;;
    esac
    case "$staged_path" in
    test/*.cpp | test/*.hpp | test/*.cu | test/*.cuh | bench/*.cpp | bench/*.hpp | bench/*.cu | bench/*.cuh)
        check_test_destructors_own_nothing
        [ "$staged_path" = test/harness.hpp ] || check_cpp_scaffolding_in_one_header
        ;;
    esac
    case "$staged_path" in
    test/helpers.py | test/utf8_helpers.py | test/conftest.py) ;;
    test/*.py) check_python_scaffolding_in_helpers ;;
    esac
    case "$staged_path" in
    test/*.py)
        check_seed_values_parametrized
        check_fuzz_loops_scaled
        ;;
    esac
}

# endregion StringZilla Rules

# region Dispatch

git rev-parse --verify HEAD > /dev/null 2>&1 || exit 0

# `--all-lines <path>...` judges whole working-tree files as though every line outside a function body were
# added, and `--changed-lines <path>...` judges the lines they changed since HEAD; both skip the formatters
# and the checks over the commit as a whole. With no arguments the hook judges what is staged.
if [ "${1:-}" = --changed-lines ]; then
    shift
    for staged_path in "$@"; do
        [ "$staged_path" = .githooks/selftest ] && continue
        [ -f "$staged_path" ] || continue
        staged_added_text=$(git diff HEAD --unified=0 -- "$staged_path" | grep '^+' | grep -v '^+++' || true)
        [ -n "$staged_added_text" ] || continue
        staged_added_line_numbers_list=$(git diff HEAD --unified=0 -- "$staged_path" | awk '
            /^@@/ {
                split($3, range, ",")
                start = substr(range[1], 2) + 0
                count = (range[2] == "") ? 1 : range[2] + 0
                for (line = start; line < start + count; ++line) print line
            }')
        staged_file_text=$(cat -- "$staged_path")
        run_shared_checks
        run_project_checks
    done
elif [ "${1:-}" = --all-lines ]; then
    shift
    for staged_path in "$@"; do
        [ "$staged_path" = .githooks/selftest ] && continue
        [ -f "$staged_path" ] || continue
        staged_file_text=$(cat -- "$staged_path")
        [ -n "$staged_file_text" ] || continue
        staged_added_line_numbers_list=$(lines_outside_function_bodies)
        staged_added_text=$(printf '%s\n' "$staged_file_text" | awk 'NR == FNR { kept[$1]; next } FNR in kept { print "+" $0 }' \
            <(printf '%s\n' "$staged_added_line_numbers_list") -)
        run_shared_checks
        run_project_checks
    done
else
    while IFS= read -r -d '' staged_path; do
        # The selftest carries one violation per rule by design.
        [ "$staged_path" = .githooks/selftest ] && continue
        check_generated_artifacts
        staged_added_text=$(git diff --cached --unified=0 -- "$staged_path" | grep '^+' | grep -v '^+++' || true)
        [ -n "$staged_added_text" ] || continue
        staged_added_line_numbers_list=$(staged_added_line_numbers "$staged_path")
        staged_file_text=$(git show ":$staged_path")
        run_shared_checks
        run_shared_formatters
        run_project_checks
    done < <(git diff --cached --name-only -z --diff-filter=ACM)
    run_tree_checks
fi

# endregion Dispatch

if [ "$rejection_count" -ne 0 ]; then
    echo ""
    echo "pre-commit: $rejection_count check(s) failed"
    echo "Fix the staged changes and commit again. Bypass knowingly with: git commit --no-verify"
    exit 1
fi
exit 0
