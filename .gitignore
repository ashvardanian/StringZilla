# Build trees and CMake
/build*/
CMakeFiles
CMakeCache.txt
cmake_install.cmake
Makefile

# Per-developer preset overrides: toolchain paths that are true of one machine, not of the project
CMakeUserPresets.json

# C and C++
*.so
*.a
*.dll
*.dylib
*.tar.gz

# Profilers
*.profraw
*.profdata

# Python
__pycache__
*.egg-info
*.whl
*.pyd
.venv/*
.pytest_cache
.ruff_cache/
.mypy_cache/
# A minimal binding with few dependencies would carry thousands of lockfile lines
uv.lock

# Rust
/target*/

# JavaScript
node_modules/
package-lock.json
prebuilds/
# Per-platform npm prebuilts are filled in CI, never committed
javascript/@stringzilla-*/*.node

# Swift
.build/
.swiftpm/

# Java
.gradle/

# C#
bin/
obj/
TestResults/
*.dmp
# Native binaries are pack-time artifacts, never committed
/csharp/runtimes/

# Editors, assistants, language servers and tool caches
/compile_commands.json
/.cache/
.claude/
CLAUDE.local.md
.vs/

# macOS
.DS_Store

# Local scratch
tmp/
.tmp/
/failed_sz_*
/SPLIT.md

